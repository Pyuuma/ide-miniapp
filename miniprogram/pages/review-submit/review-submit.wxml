<view class="card">
  <view class="section-title">选择平台</view>
  <view class="platforms">
    <view
      wx:for="{{platforms}}"
      wx:key="id"
      class="platform {{platform === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="selectPlatform"
    >{{item.name}}</view>
  </view>
  <view class="muted">每个平台每月可加一次分，审核通过后 +3 分</view>
</view>

<view class="card">
  <view class="section-title">评论截图（必填）</view>
  <view class="images">
    <view wx:for="{{images}}" wx:key="*this" class="image-item">
      <image class="preview" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="removeImage"></image>
      <view class="remove" data-index="{{index}}" catchtap="removeImage">×</view>
    </view>
    <view class="add-btn" bindtap="chooseImages">＋</view>
  </view>
</view>

<view class="card">
  <view class="section-title">文字说明（选填）</view>
  <textarea class="textarea" value="{{text}}" maxlength="500" placeholder="例如：已在店消费后发布评价…" bindinput="onTextInput"></textarea>

  <view class="section-title">笔记/评价链接（选填）</view>
  <input class="input" value="{{link}}" maxlength="500" placeholder="粘贴小红书笔记或大众点评评价链接" bindinput="onLinkInput" />
</view>

<button class="btn-primary submit" bindtap="onSubmit" disabled="{{submitting}}">提交审核</button>
