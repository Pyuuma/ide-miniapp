<view class="page">
  <view class="card">
    <view class="title">超级管理台</view>
    <view class="muted">管理员名单与规则配置分别在独立页面编辑、保存。</view>
  </view>
  <view class="card entry" bindtap="openAdmins">
    <view class="entry-main">
      <view class="section-title">管理员名单</view>
      <view class="muted">维护普通管理员，查看超级管理员名单</view>
    </view>
    <text class="arrow">›</text>
  </view>
  <view class="card entry" bindtap="openConfig">
    <view class="entry-main">
      <view class="section-title">规则配置</view>
      <view class="muted">门店、档位、周期、加分、等级与隐私政策</view>
    </view>
    <text class="arrow">›</text>
  </view>
</view>
