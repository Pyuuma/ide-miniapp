<view class="page">
  <view class="card">
    <view class="section-title">赛事标题</view>
    <input class="input" value="{{title}}" maxlength="50" placeholder="赛事名称" bindinput="onTitleInput" />
  </view>

  <view class="card">
    <view class="section-title">图片轮播（1–9 张）</view>
    <view class="images">
      <view wx:for="{{images}}" wx:key="*this" class="image-item">
        <image class="image-preview" src="{{item}}" mode="aspectFill"></image>
        <view class="remove" data-index="{{index}}" catchtap="removeImage">×</view>
      </view>
      <view class="add-btn" bindtap="chooseImages">＋</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">状态</view>
    <view class="status-options">
      <view
        wx:for="{{statusOptions}}"
        wx:key="id"
        class="status-opt {{status === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onStatus"
      >{{item.name}}</view>
    </view>
  </view>

  <view class="card">
    <view class="form-group">
      <view class="time-heading">
        <view class="form-label">报名开始时间（可选）</view>
        <button class="btn-plain btn-compact" bindtap="clearRegisterStart">清除</button>
      </view>
      <view class="deadline-row">
        <picker class="date-picker" mode="date" value="{{registerStartDate}}" bindchange="onRegisterStartDateChange">
          <view class="picker {{registerStartDate ? '' : 'placeholder'}}">{{registerStartDate || '选择日期'}}</view>
        </picker>
        <picker class="time-picker" mode="time" value="{{registerStartTime}}" bindchange="onRegisterStartTimeChange">
          <view class="picker {{registerStartTime ? '' : 'placeholder'}}">{{registerStartTime || '选择时间'}}</view>
        </picker>
      </view>
    </view>
    <view class="form-group">
      <view class="time-heading">
        <view class="form-label">报名截止时间（可选）</view>
        <button class="btn-plain btn-compact" bindtap="clearDeadline">清除</button>
      </view>
      <view class="deadline-row">
        <picker class="date-picker" mode="date" value="{{deadlineDate}}" bindchange="onDateChange">
          <view class="picker {{deadlineDate ? '' : 'placeholder'}}">{{deadlineDate || '选择日期'}}</view>
        </picker>
        <picker class="time-picker" mode="time" value="{{deadlineTime}}" bindchange="onTimeChange">
          <view class="picker {{deadlineTime ? '' : 'placeholder'}}">{{deadlineTime || '选择时间'}}</view>
        </picker>
      </view>
    </view>
    <view class="form-group">
      <view class="form-label">名额上限（可选，留空不限）</view>
      <input class="input" type="number" value="{{capacity}}" placeholder="例如：16" bindinput="onCapacityInput" />
    </view>
  </view>

  <view class="card">
    <view class="section-title">赛事说明（Markdown）</view>
    <view class="mode-tabs">
      <view class="mode-tab {{mode === 'edit' ? 'active' : ''}}" data-mode="edit" bindtap="switchMode">编辑</view>
      <view class="mode-tab {{mode === 'preview' ? 'active' : ''}}" data-mode="preview" bindtap="switchMode">预览</view>
    </view>
    <textarea
      wx:if="{{mode === 'edit'}}"
      class="textarea markdown-input"
      value="{{contentMarkdown}}"
      maxlength="10000"
      placeholder="支持 Markdown：标题、加粗、列表、代码块、图片等"
      bindinput="onMarkdownInput"
    ></textarea>
    <rich-text wx:else class="markdown-preview" nodes="{{previewHtml}}"></rich-text>
  </view>

  <button class="btn-primary submit" bindtap="onSave" disabled="{{saving}}">保存</button>
  <button wx:if="{{id && status === 'draft'}}" class="btn-plain submit danger" bindtap="onDelete" disabled="{{saving}}">删除草稿</button>
</view>
