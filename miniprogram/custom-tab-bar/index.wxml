<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon">
      <block wx:if="{{item.key === 'member'}}">
        <view class="part card"></view>
        <view class="part chip filled"></view>
        <view class="part stripe"></view>
      </block>
      <block wx:elif="{{item.key === 'points'}}">
        <view class="part coin"></view>
        <view class="part hole"></view>
      </block>
      <block wx:elif="{{item.key === 'events'}}">
        <view class="part cal"></view>
        <view class="part cal-line"></view>
        <view class="part cal-dot filled"></view>
      </block>
      <block wx:else>
        <view class="part head"></view>
        <view class="part shoulder"></view>
      </block>
    </view>
    <view class="tab-text">{{item.text}}</view>
  </view>
</view>
